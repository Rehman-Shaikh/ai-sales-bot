PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/salesbot
CLIENT_URL=http://localhost:5173

# Add at least ONE of these. With both, Groq is tried first and Gemini is the backup.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional: extra model names to try. The built-in working models are always tried first.
# GROQ_MODEL=
# GEMINI_MODEL=
